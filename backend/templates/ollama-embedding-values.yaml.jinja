models:
  pull:
{% for tag in models %}
    - "{{ tag }}"
{% endfor %}

service:
  type: {{ service.type | default('ClusterIP') }}
  port: {{ service.port | default(80) }}

replicaCount: {{ replicaCount | default(1) }}

resources:
  requests:
    cpu: "{{ resources.requests.cpu or '1' }}"
    memory: "{{ resources.requests.memory or '2Gi' }}"
  limits:
{% if resources.limits.cpu %}
    cpu: "{{ resources.limits.cpu }}"
{% endif %}
    memory: "{{ resources.limits.memory or '4Gi' }}"

env:
{% for env_var in env %}
  - name: {{ env_var.name }}
    value: "{{ env_var.value }}"
{% endfor %}

{% if nodeSelector.hostname is defined %}
nodeSelector:
  kubernetes.io/hostname: {{ nodeSelector.hostname }}
{% endif %}
