replicaCount: {{ replicaCount | default(1) }}
model: {{ model | default("mistralai/Mistral-7B-Instruct-v0.1") }}
servedModelName: {{ servedModelName | default("") }}
quantization: {{ quantization | default("") }}
dtype: {{ dtype | default("") }}
gpuMemoryUtilization: {{ gpuMemoryUtilization | default("") }}
maxModelLen: {{ maxModelLen | default("") }}
chatTemplate: {{ chatTemplate | default("") }}

readManyPVC:
  enabled: {{ readManyPVC.enabled | default(false) }}
  sourcePVC: {{ readManyPVC.sourcePVC | default("") }}
  accessModes:
  - {{ readManyPVC.accessModes[0] | default("ReadOnlyMany") }}
  mountPath: {{ readManyPVC.mountPath | default("/model") }}
  size: {{ readManyPVC.size | default("30Gi") }}
  storageClass: {{ readManyPVC.storageClass | default("") }}

deploymentAnnotations: {{ deploymentAnnotations | default({}) }}

resources:
  requests:
    cpu: {{ resources.requests.cpu | default("2") }}
    memory: {{ resources.requests.memory | default("4Gi") }}
    nvidia.com/gpu: {{ resources.requests.gpu | default(1) }}
  limits:
    nvidia.com/gpu: {{ resources.limits.gpu | default(1) }}

env:
  - name: HF_TOKEN
    valueFrom:
      secretKeyRef:
        name: hf-api-token
        key: HF_API_TOKEN
  - name: HF_HUB_OFFLINE
    value: "{{ env.HF_HUB_OFFLINE | default('1') }}"
  - name: HF_HUB_CACHE
    value: {{ volumeMounts.hf_cache.mountPath | default("/model") }}
  - name: MAX_MODEL_LEN
    value: "{{ maxModelLen | default('4192') }}"
port: {{ port | default(8080) }}

nodeSelector: {{ nodeSelector | default({}) }}

image:
  repository: {{ image.repository | default("substratusai/vllm") }}
  pullPolicy: {{ image.pullPolicy | default("IfNotPresent") }}
  tag: {{ image.tag | default("") }}

service:
  type: {{ service.type | default("ClusterIP") }}
  port: {{ service.port | default(80) }}

tolerations: {{ tolerations | default([]) }}

affinity: {{ affinity | default({}) }}

volumes:
  - name: hf-cache
    persistentVolumeClaim:
      claimName: {{ volumes.hf_cache.claimName | default("hf-cache") }}

volumeMounts:
  - name: hf-cache
    mountPath: {{ volumeMounts.hf_cache.mountPath | default("/model") }}

runtimeClassName: {{ runtimeClassName | default("null") }}