# Copy to .env.local and adjust. All values are read at build time.

# Backend API base URL. The Next.js proxy rewrites /api/v1alpha1/* to it.
NEXT_PUBLIC_AIOPS_BACKEND_URL=http://localhost:8000

# Langflow UI embedded on the Develop page. Leave empty to show a placeholder.
NEXT_PUBLIC_LANGFLOW_URL=http://localhost:7860

# Grafana base URL for the inference endpoint dashboards. Leave empty to show a placeholder.
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3001

# Jaeger UI base URL for the inference endpoint traces. Leave empty to show a placeholder.
NEXT_PUBLIC_JAEGER_URL=http://localhost:16686
