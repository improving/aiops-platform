# Copy to .env.local and adjust. NEXT_PUBLIC_* values are read at build time.

# Backend API base URL. The Next.js proxy rewrites /api/v1alpha1/* to it.
NEXT_PUBLIC_AIOPS_BACKEND_URL=http://localhost:8000
# Server-side override read at request time (no rebuild needed). Optional.
# AIOPS_BACKEND_URL=http://aiops-backend:8000

# Langflow UI embedded on the Develop page. Leave empty to show a placeholder.
NEXT_PUBLIC_LANGFLOW_URL=http://localhost:7860

# Grafana base URL for the inference endpoint dashboards. Leave empty to show a placeholder.
NEXT_PUBLIC_GRAFANA_URL=https://grafana.127.0.0.1.nip.io

# Jaeger UI base URL for the inference endpoint traces. Leave empty to show a placeholder.
NEXT_PUBLIC_JAEGER_URL=http://localhost:16686

# --- Authentication (Auth.js + Keycloak) --------------------------------
# Server-side mode: `oidc` (default) or `disabled`. `disabled` skips the login
# redirect and the bearer header; the server logs a warning at startup.
AUTH_MODE=oidc
# Encrypts the session cookie. Any long random string; this is the dev value.
AUTH_SECRET=dev-auth-secret-change-me
# Public URL of this UI; Keycloak redirects back to it after sign-in.
AUTH_URL=http://localhost:3000
# Keycloak realm issuer (the realm of the local kind stack).
AUTH_KEYCLOAK_ISSUER=https://auth.127.0.0.1.nip.io/realms/aiops
# Public client with PKCE; no client secret.
AUTH_KEYCLOAK_ID=aiops-ui
# Build-time mirror of AUTH_MODE for the browser; it only hides the user menu.
NEXT_PUBLIC_AUTH_MODE=oidc
# The realm is served through the gateway with a certificate from the local
# CA, and Node needs it to call Keycloak. Node reads this variable only from
# the process environment at startup, so it has no effect in this file:
# export it in the shell (or run `make frontend`, which sets it).
# export NODE_EXTRA_CA_CERTS=../infra/local/ca/ca.crt
