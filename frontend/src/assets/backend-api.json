  "components": {
    "schemas": {
      "Engine": {
        "properties": {
          "id": { "type": "string", "format": "uuid", "title": "Id" },
          "name": { "type": "string", "title": "Name", "default": "" },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "helm_chart_repo": {
            "type": "string",
            "title": "Helm Chart Repo",
            "default": ""
          }
        },
        "type": "object",
        "title": "Engine"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": { "$ref": "#/components/schemas/ValidationError" },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Host": {
        "properties": {
          "hostname": { "type": "string", "title": "Hostname" },
          "cpu_vendor": { "type": "string", "title": "Cpu Vendor" },
          "cpu_memory": { "type": "integer", "title": "Cpu Memory" },
          "cpu_cores": { "type": "integer", "title": "Cpu Cores" },
          "cuda_driver_version": {
            "type": "string",
            "title": "Cuda Driver Version"
          },
          "cuda_runtime_version": {
            "type": "string",
            "title": "Cuda Runtime Version"
          },
          "gpu_count": { "type": "integer", "title": "Gpu Count" },
          "gpu_memory": { "type": "integer", "title": "Gpu Memory" },
          "gpu_model": { "type": "string", "title": "Gpu Model" },
          "gpu_replicas": { "type": "integer", "title": "Gpu Replicas" },
          "gpu_sharing_strategy": {
            "type": "string",
            "title": "Gpu Sharing Strategy"
          }
        },
        "type": "object",
        "required": [
          "hostname",
          "cpu_vendor",
          "cpu_memory",
          "cpu_cores",
          "cuda_driver_version",
          "cuda_runtime_version",
          "gpu_count",
          "gpu_memory",
          "gpu_model",
          "gpu_replicas",
          "gpu_sharing_strategy"
        ],
        "title": "Host"
      },
      "InferenceInstance": {
        "properties": {
          "id": { "type": "string", "format": "uuid", "title": "Id" },
          "model": { "$ref": "#/components/schemas/Model" },
          "engine": { "$ref": "#/components/schemas/Engine" },
          "host": { "type": "string", "title": "Host" },
          "config": {
            "$ref": "#/components/schemas/InferenceInstanceConfigParams"
          },
          "endpoint": { "type": "string", "title": "Endpoint", "default": "" },
          "healthEndpoint": {
            "type": "string",
            "title": "Healthendpoint",
            "default": ""
          },
          "metricsEndpoint": {
            "type": "string",
            "title": "Metricsendpoint",
            "default": ""
          }
        },
        "type": "object",
        "required": ["model", "engine", "host", "config"],
        "title": "InferenceInstance"
      },
      "InferenceInstanceConfigParams": {
        "properties": {
          "id": { "type": "string", "format": "uuid", "title": "Id" },
          "maxInputLength": { "type": "integer", "title": "Maxinputlength" },
          "maxTokens": { "type": "integer", "title": "Maxtokens" },
          "maxBatchPrefillTokens": {
            "type": "integer",
            "title": "Maxbatchprefilltokens"
          },
          "maxBatchTotalTokens": {
            "type": "integer",
            "title": "Maxbatchtotaltokens"
          },
          "quantization": { "type": "string", "title": "Quantization" },
          "image": { "type": "string", "title": "Image" }
        },
        "type": "object",
        "required": [
          "maxInputLength",
          "maxTokens",
          "maxBatchPrefillTokens",
          "maxBatchTotalTokens",
          "quantization",
          "image"
        ],
        "title": "InferenceInstanceConfigParams"
      },
      "Model": {
        "properties": {
          "id": { "type": "string", "format": "uuid", "title": "Id" },
          "name": { "type": "string", "title": "Name", "default": "" },
          "modelId": { "type": "string", "title": "Modelid", "default": "" },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "category": { "type": "string", "title": "Category", "default": "" },
          "subcategory": {
            "type": "string",
            "title": "Subcategory",
            "default": ""
          },
          "size": { "type": "integer", "title": "Size", "default": 0 }
        },
        "type": "object",
        "title": "Model"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": { "anyOf": [{ "type": "string" }, { "type": "integer" }] },
            "type": "array",
            "title": "Location"
          },
          "msg": { "type": "string", "title": "Message" },
          "type": { "type": "string", "title": "Error Type" }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      }
    }
  }
